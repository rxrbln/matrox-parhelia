; warp_transform plus the single texture-coordinate pass-through of
; warp_textured: object-space xyz in v0, colour in v5, texcoord set 0 in v7,
; MVP in c0..c3, viewport scale/offset in c8/c9.  Like warp_textured this
; program must NOT write temporary T2.
add T0, v0, v0.0000
dp4 r2.w, T0, c3
dp4 r2.z, T0, c2
dp4 r2.y, T0, c1
dp4 r2.x, T0, c0
add o1, v5, r1.0000 | mov T1, c9
smul r5, r2, r2.xyz1 | mov o11, r2
mad T1.xyz, c8.xyz1, r5, T1.xyz0
; o0.w carries 1/w for perspective-correct interpolation in the setup unit;
; T1.w is still the viewport height from c9.
add o0.xyz, T1, r1.0000
add o0.w, r5, r1.0000
wra | mov o3, v7
end
wra
